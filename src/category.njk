---
layout: base.njk
pagination:
  data: collections.byCategory
  size: 1
  alias: cat
permalink: "/category/{{ cat.slug }}/"
eleventyComputed:
  pageTitle: "{{ cat.slug | catName }}"
---
<div class="page-head"><h1>{{ cat.slug | catName }}</h1></div>
<ul class="index">
{% for p in cat.posts %}  <li><span class="t"><a href="{{ p.url }}">{{ p.data.title }}</a></span><time datetime="{{ p.date | isoDate }}">{{ p.date | niceDate }}</time></li>
{% endfor %}</ul>
